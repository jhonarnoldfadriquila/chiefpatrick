# Copy to .env.local (development) or set on the server (production). Never commit real values.

# ---- PostgreSQL (Supabase) ----
# Supabase: Project → Connect → "Session pooler" connection string, with your database password.
# Local PostgreSQL also works, e.g. postgresql://postgres:password@localhost:5432/cpk
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- First admin account (created by `npm run db:setup` when no users exist) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@chefpatrickskitchen.ph
# At least 8 characters. Change it after first sign-in.
ADMIN_PASSWORD=

# ---- Sessions ----
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Development only: open /admin without signing in (acts as the first admin account).
# Has no effect when NODE_ENV=production.
# ADMIN_AUTH_DISABLED=true

# ---- Uploads ----
# Folder for photos uploaded from the admin (default: ./uploads)
# UPLOAD_DIR=

# Signed-out visitors can browse /admin read-only (saving is refused). Set to false to require sign-in.
# ADMIN_VIEW_ONLY_DEMO=false
